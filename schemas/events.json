{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FinanceNik/Freeloop/schemas/events.json",
  "title": "Freeloop session event",
  "description": "One line of a session transcript (sessions/<id>/events.jsonl). Schema v0 (EXT-002): a strict superset of ACP session/update (OQ-012). ACP variants keep ACP's type name and payload minus the sessionUpdate discriminator; payload fields are camelCase. Variants without a payload definition below are reserved: their payload is not fixed yet and may be any object.",
  "type": "object",
  "required": ["v", "seq", "ts", "sid", "type", "data"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1, "description": "Schema version." },
    "seq": { "type": "integer", "minimum": 1, "description": "Per-session sequence number, contiguous from 1." },
    "ts": { "type": "string", "format": "date-time", "description": "UTC time the engine persisted the event." },
    "sid": { "type": "string", "minLength": 1, "description": "Session ID." },
    "type": {
      "enum": [
        "user_message_chunk",
        "agent_message_chunk",
        "agent_thought_chunk",
        "tool_call",
        "tool_call_update",
        "plan",
        "available_commands_update",
        "current_mode_update",
        "config_option_update",
        "session_info_update",
        "usage_update",
        "notice",
        "compaction_update",
        "compaction_summary_chunk",
        "turn_started",
        "turn_ended",
        "permission_requested",
        "permission_decided",
        "session_status",
        "git_state",
        "model_changed",
        "env_health",
        "hook_ran",
        "error",
        "history_message",
        "checkpoint",
        "rewind",
        "handoff",
        "pull_request",
        "tags_changed",
        "worktree_setup",
        "optimizer_changed",
        "effort_changed",
        "session_rule_changed",
        "session_imported",
        "limit_update",
        "mode_refused",
        "stuck",
        "handed_off",
        "model_context",
        "workflow_changed",
        "workflow_stage"
      ],
      "x-acp-types": [
        "user_message_chunk",
        "agent_message_chunk",
        "agent_thought_chunk",
        "tool_call",
        "tool_call_update",
        "plan",
        "available_commands_update",
        "current_mode_update",
        "config_option_update",
        "session_info_update",
        "usage_update",
        "notice",
        "compaction_update",
        "compaction_summary_chunk"
      ]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["user_message_chunk", "agent_message_chunk", "agent_thought_chunk"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/messageChunk" } } }
    },
    {
      "if": { "properties": { "type": { "const": "session_status" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/sessionStatus" } } }
    },
    {
      "if": { "properties": { "type": { "const": "turn_ended" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/turnEnded" } } }
    },
    {
      "if": { "properties": { "type": { "const": "history_message" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/historyMessage" } } }
    },
    {
      "if": { "properties": { "type": { "const": "git_state" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/gitState" } } }
    },
    {
      "if": { "properties": { "type": { "const": "usage_update" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/usage" } } }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/error" } } }
    },
    {
      "if": { "properties": { "type": { "const": "hook_ran" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/hookRan" } } }
    },
    {
      "if": { "properties": { "type": { "const": "tags_changed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/tags" } } }
    },
    {
      "if": { "properties": { "type": { "const": "worktree_setup" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/worktreeSetup" } } }
    },
    {
      "if": { "properties": { "type": { "const": "optimizer_changed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/optimizerChanged" } } }
    },
    {
      "if": { "properties": { "type": { "const": "workflow_changed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/workflowChanged" } } }
    },
    {
      "if": { "properties": { "type": { "const": "workflow_stage" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/workflowStage" } } }
    },
    {
      "if": { "properties": { "type": { "const": "effort_changed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/effortChanged" } } }
    },
    {
      "if": { "properties": { "type": { "const": "session_imported" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/sessionImported" } } }
    },
    {
      "if": { "properties": { "type": { "const": "limit_update" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/limitUpdate" } } }
    },
    {
      "if": { "properties": { "type": { "const": "stuck" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/stuck" } } }
    },
    {
      "if": { "properties": { "type": { "const": "handed_off" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/handedOff" } } }
    },
    {
      "if": { "properties": { "type": { "const": "model_context" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/modelContext" } } }
    },
    {
      "if": { "properties": { "type": { "const": "mode_refused" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/modeRefused" } } }
    },
    {
      "if": { "properties": { "type": { "const": "session_rule_changed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/sessionRuleChanged" } } }
    }
  ],
  "$defs": {
    "modelContext": {
      "type": "object",
      "description": "What one kind of model call for the session carries besides the conversation, recorded when it changes (NFR-PRIV-003).",
      "required": ["purpose", "model", "system", "tools"],
      "properties": {
        "purpose": { "enum": ["turn", "compaction", "commit_message", "pull_request", "handoff"] },
        "providerId": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "system": { "type": "string" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "inputSchema": { "type": "object" } }
          }
        },
        "sent": { "type": "string", "description": "What else went with a call that is not a turn, in words." }
      }
    },
    "sessionImported": {
      "type": "object",
      "description": "The agent's session this one was imported from. What it replayed comes before this event, and the usage views leave it out.",
      "required": ["harness", "source"],
      "properties": {
        "harness": { "type": "string" },
        "source": { "type": "string" },
        "copy": { "type": "string" }
      }
    },
    "sessionRuleChanged": {
      "type": "object",
      "description": "A rule the user added to a session, or removed from it.",
      "required": ["rule"],
      "properties": { "rule": { "type": "object" }, "removed": { "type": "boolean" } }
    },
    "effortChanged": {
      "type": "object",
      "description": "The effort the session's model calls ask for (PRV-014).",
      "required": ["effort"],
      "properties": { "effort": { "type": "string" } }
    },
    "modeRefused": {
      "type": "object",
      "description": "An agent tried to loosen the mode on its own, and it stayed as it was; or the user chose a mode approving a plan that does not hold, and the session asks instead.",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "chosen": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "stuck": {
      "type": "object",
      "description": "A session that is not getting on, and where it could continue (HRN-020).",
      "required": ["reason", "detail"],
      "properties": {
        "reason": { "enum": ["limit", "max_turns", "tool_failures", "rewinds", "errors"] },
        "detail": { "type": "string" },
        "profileId": { "type": "string" },
        "profileName": { "type": "string" },
        "auto": { "type": "boolean" }
      }
    },
    "handedOff": {
      "type": "object",
      "description": "The session continued in another (HRN-020).",
      "required": ["toSessionId", "toTitle", "profileName"],
      "properties": {
        "toSessionId": { "type": "string" },
        "toTitle": { "type": "string" },
        "profileName": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "limitUpdate": {
      "type": "object",
      "required": ["source", "windows"],
      "properties": {
        "source": { "type": "string" },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "usedPercent", "resetsAt", "status"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
              "resetsAt": { "type": "integer" },
              "status": { "enum": ["allowed", "warning", "rejected"] }
            }
          }
        }
      }
    },
    "optimizerChanged": {
      "type": "object",
      "description": "The session's token optimizer (HRN-019); an empty optimizer means off.",
      "required": ["optimizer"],
      "properties": { "optimizer": { "type": "string" }, "name": { "type": "string" } }
    },
    "workflowChanged": {
      "type": "object",
      "description": "The session's workflow (WFL-002); an empty workflow means none.",
      "required": ["workflow"],
      "properties": { "workflow": { "type": "string" }, "name": { "type": "string" } }
    },
    "workflowStage": {
      "type": "object",
      "description": "A stage of the session's workflow starting (WFL-008): its command, title and kind.",
      "required": ["workflow", "command", "kind"],
      "properties": { "workflow": { "type": "string" }, "command": { "type": "string" }, "title": { "type": "string" }, "kind": { "type": "string" } }
    },
    "worktreeSetup": {
      "type": "object",
      "description": "The setup of a session's own worktree (SES-016): files copied from the main checkout and the setup command, with the end of its output.",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["running", "done", "failed", "skipped"] },
        "copied": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "string" },
        "output": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "tags": {
      "type": "object",
      "description": "A session's tags from this event on (SES-013): lower case, without spaces, sorted, each at most 32 characters.",
      "required": ["tags"],
      "properties": {
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[^\\sA-Z]{1,32}$" }, "maxItems": 16 }
      }
    },
    "hookRan": {
      "type": "object",
      "description": "One hook run (EXT-005). Exit code 2 blocked what it ran for; any other non-zero code, a timeout or an error was reported and the session went on, and for a pre_tool_use or permission_request hook the call was put to the user, whose permission_requested then names the failure in hookFailed.",
      "required": ["event", "command", "exitCode"],
      "properties": {
        "event": { "enum": ["session_start", "pre_tool_use", "permission_request", "post_tool_use"] },
        "command": { "type": "string" },
        "source": { "type": "string" },
        "tool": { "type": "string" },
        "toolCallId": { "type": "string" },
        "exitCode": { "type": "integer" },
        "timedOut": { "type": "boolean" },
        "durationMs": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "blocked": { "type": "boolean" },
        "error": { "type": "string" },
        "stopped": { "type": "boolean" }
      }
    },
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "description": "ACP content block type: \"text\", \"resource_link\" for a file a user message mentions, or \"image\" for a picture the user attached (SES-015), whose uri is attachment:<name> in the session's attachments folder instead of ACP's inline data." },
        "mimeType": { "type": "string", "description": "image: the picture's media type." },
        "text": { "type": "string" },
        "uri": { "type": "string", "description": "resource_link: the file's file:// URI." },
        "name": { "type": "string", "description": "resource_link: the path relative to the project root." }
      }
    },
    "messageChunk": {
      "type": "object",
      "required": ["content"],
      "properties": { "content": { "$ref": "#/$defs/contentBlock" } }
    },
    "sessionStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["idle", "running", "queued", "waiting_permission", "waiting_input", "error", "archived"] }
      }
    },
    "turnEnded": {
      "type": "object",
      "required": ["stopReason"],
      "properties": {
        "stopReason": { "enum": ["end_turn", "max_tokens", "max_turns", "refusal", "cancelled", "error"] }
      }
    },
    "historyMessage": {
      "type": "object",
      "description": "Built-in harness context: message number index (0-based) is set to message. Later events with the same index replace earlier ones.",
      "required": ["index", "message"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "message": { "type": "object", "required": ["role", "parts"] }
      }
    },
    "gitState": {
      "type": "object",
      "description": "The session's checkout: branch (empty when detached), HEAD, number of changed or untracked files, and the commit the session started at.",
      "required": ["repo"],
      "properties": {
        "repo": { "type": "boolean" },
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "dirty": { "type": "integer", "minimum": -1, "description": "-1 when not checked, because the repository configures content filters git status could run." },
        "baseCommit": { "type": "string" },
        "commits": {
          "type": "array",
          "description": "Commits HEAD moved forward over since the session last looked, merges left out (GUI-051).",
          "items": {
            "type": "object",
            "required": ["sha", "at", "added", "deleted", "files"],
            "properties": {
              "sha": { "type": "string" },
              "at": { "type": "integer", "description": "Commit time, Unix seconds." },
              "added": { "type": "integer", "minimum": -1 },
              "deleted": { "type": "integer", "minimum": -1 },
              "files": { "type": "integer", "minimum": -1 }
            }
          }
        },
        "cause": { "enum": ["commit"], "description": "The app made the commit for this session." }
      }
    },
    "usage": {
      "type": "object",
      "description": "Tokens of one model call.",
      "properties": {
        "inputTokens": { "type": "integer" },
        "outputTokens": { "type": "integer" },
        "cacheReadTokens": { "type": "integer" },
        "cacheWriteTokens": { "type": "integer" },
        "cacheWrite1hTokens": { "type": "integer" },
        "adjustment": { "type": "boolean" },
        "contextTokens": { "type": "integer" },
        "contextWindow": { "type": "integer" },
        "providerId": { "type": "string" },
        "model": { "type": "string" },
        "measured": { "enum": ["turn", "none"], "description": "How an external agent's usage was counted: a turn's total, or none reported. Absent: per model call." }
      }
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" }
      }
    }
  }
}
