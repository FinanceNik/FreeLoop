{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FinanceNik/Freeloop/schemas/events.json",
  "title": "Freeloop session event",
  "description": "One line of a session transcript (sessions/<id>/events.jsonl). Schema v0 (EXT-002): a strict superset of ACP session/update (OQ-012). ACP variants keep ACP's type name and payload minus the sessionUpdate discriminator; payload fields are camelCase. Variants without a payload definition below are reserved: their payload is not fixed yet and may be any object.",
  "type": "object",
  "required": ["v", "seq", "ts", "sid", "type", "data"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1, "description": "Schema version." },
    "seq": { "type": "integer", "minimum": 1, "description": "Per-session sequence number, contiguous from 1." },
    "ts": { "type": "string", "format": "date-time", "description": "UTC time the engine persisted the event." },
    "sid": { "type": "string", "minLength": 1, "description": "Session ID." },
    "type": {
      "enum": [
        "user_message_chunk",
        "agent_message_chunk",
        "agent_thought_chunk",
        "tool_call",
        "tool_call_update",
        "plan",
        "available_commands_update",
        "current_mode_update",
        "config_option_update",
        "session_info_update",
        "usage_update",
        "notice",
        "compaction_update",
        "compaction_summary_chunk",
        "turn_started",
        "turn_ended",
        "permission_requested",
        "permission_decided",
        "session_status",
        "git_state",
        "model_changed",
        "env_health",
        "hook_ran",
        "error",
        "history_message",
        "checkpoint",
        "rewind"
      ],
      "x-acp-types": [
        "user_message_chunk",
        "agent_message_chunk",
        "agent_thought_chunk",
        "tool_call",
        "tool_call_update",
        "plan",
        "available_commands_update",
        "current_mode_update",
        "config_option_update",
        "session_info_update",
        "usage_update",
        "notice",
        "compaction_update",
        "compaction_summary_chunk"
      ]
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["user_message_chunk", "agent_message_chunk", "agent_thought_chunk"] } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/messageChunk" } } }
    },
    {
      "if": { "properties": { "type": { "const": "session_status" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/sessionStatus" } } }
    },
    {
      "if": { "properties": { "type": { "const": "turn_ended" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/turnEnded" } } }
    },
    {
      "if": { "properties": { "type": { "const": "history_message" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/historyMessage" } } }
    },
    {
      "if": { "properties": { "type": { "const": "git_state" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/gitState" } } }
    },
    {
      "if": { "properties": { "type": { "const": "usage_update" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/usage" } } }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/error" } } }
    }
  ],
  "$defs": {
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "description": "ACP content block type: \"text\", or \"resource_link\" for a file a user message mentions." },
        "text": { "type": "string" },
        "uri": { "type": "string", "description": "resource_link: the file's file:// URI." },
        "name": { "type": "string", "description": "resource_link: the path relative to the project root." }
      }
    },
    "messageChunk": {
      "type": "object",
      "required": ["content"],
      "properties": { "content": { "$ref": "#/$defs/contentBlock" } }
    },
    "sessionStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["idle", "running", "waiting_permission", "waiting_input", "error", "archived"] }
      }
    },
    "turnEnded": {
      "type": "object",
      "required": ["stopReason"],
      "properties": {
        "stopReason": { "enum": ["end_turn", "max_tokens", "max_turns", "refusal", "cancelled", "error"] }
      }
    },
    "historyMessage": {
      "type": "object",
      "description": "Built-in harness context: message number index (0-based) is set to message. Later events with the same index replace earlier ones.",
      "required": ["index", "message"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "message": { "type": "object", "required": ["role", "parts"] }
      }
    },
    "gitState": {
      "type": "object",
      "description": "The session's checkout: branch (empty when detached), HEAD, number of changed or untracked files, and the commit the session started at.",
      "required": ["repo"],
      "properties": {
        "repo": { "type": "boolean" },
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "dirty": { "type": "integer", "minimum": -1, "description": "-1 when not checked, because the repository configures content filters git status could run." },
        "baseCommit": { "type": "string" }
      }
    },
    "usage": {
      "type": "object",
      "description": "Tokens of one model call.",
      "properties": {
        "inputTokens": { "type": "integer" },
        "outputTokens": { "type": "integer" },
        "cacheReadTokens": { "type": "integer" },
        "cacheWriteTokens": { "type": "integer" },
        "contextTokens": { "type": "integer" },
        "contextWindow": { "type": "integer" },
        "providerId": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "code": { "type": "string" }
      }
    }
  }
}
